<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_access_rights_employee.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="attributes">
            <attribute name="t-if">!this.pos.cashier or !this.pos.cashier.sbl_hide_pos_customer_selection_button</attribute>
        </xpath>
        <xpath expr="//t[@t-if='!this.props.showRemainingButtons']/InternalNoteButton" position="attributes">
            <attribute name="t-if">!this.pos.cashier or !this.pos.cashier.sbl_hide_pos_note_button</attribute>
        </xpath>
        <xpath expr="//t[@t-if='this.props.showRemainingButtons']//InternalNoteButton" position="attributes">
            <attribute name="t-if">!this.pos.cashier or !this.pos.cashier.sbl_hide_pos_note_button</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='() => this.pos.clickSaveOrder()']" position="attributes">
            <attribute name="t-if">(!this.pos.cashier or !this.pos.cashier.sbl_hide_pos_transfer_order_button) and !this.pos.isSmallProductScreen</attribute>
        </xpath>
        <xpath expr="//button[hasclass('more-btn')]" position="attributes">
            <attribute name="t-if">(!this.pos.cashier or !this.pos.cashier.sbl_hide_pos_actions_button) and !this.pos.isSmallProductScreen and this.props.onClickMore</attribute>
        </xpath>
    </t>
</templates>