<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('pay-button')]" position="attributes">
            <attribute name="t-if">!this.pos.scanning and (!this.pos.cashier or !this.pos.cashier.sbl_hide_pos_payment)</attribute>
        </xpath>
    </t>
</templates>